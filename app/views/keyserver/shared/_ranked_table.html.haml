-# app/views/keyserver/shared/_ranked_table.html.haml
-# locals: { title, blank_message, row_header, data }
%h2= title
- if data.blank?
  %p= blank_message
- else
  %table.data_summary
    %thead
      %tr
        %th= row_header
        %th Number of Uses 
    %tbody
      -data.each do |(name, count)|
        %tr
          %td= name 
          %td{style: "text-align: right;"}= count
